{
    "name": "hitecosystem/devices-hub",
    "description": "Raw multi-transport device hub bridged to MQTT",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ratchet/rfc6455": "^0.3",
        "react/socket": "^1.17",
        "react/http": "^1.11",
        "monolog/monolog": "^3.10",
        "php-mqtt/client": "^2.3",
        "vlucas/phpdotenv": "^5.6",
        "predis/predis": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Hub\\": ["src/Hub/", "src/"]
        }
    },
    "scripts": {
        "server": "php bin/server-hub.php",
        "server:hub": "php bin/server-hub.php",
        "simulate": "php simulator/simulate.php",
        "command:vivistar": "php simulator/vivistar-command-client.php",
        "command:wonlex": "php simulator/wonlex-command-client.php",
        "test:unit": "vendor/bin/phpunit --testsuite unit",
        "test:scenarios": "tests/scenarios/run-all.sh",
        "test": [
            "@test:unit",
            "@test:scenarios"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
