# Server
WS_HOST=0.0.0.0
WS_PORT=8080
VIVISTAR_TCP_HOST=0.0.0.0
VIVISTAR_TCP_PORT=9000
API_HOST=0.0.0.0
API_PORT=8081

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=health_watches
DB_USER=health
DB_PASS=health_secret

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# MQTT (external data plane)
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=platform_publisher
MQTT_PASSWORD=platform_publisher_dev
MQTT_TOPIC_PREFIX=
MQTT_CLIENT_ID_PREFIX=health-mqtt
MQTT_KEEPALIVE=60
MQTT_TIMEOUT=5
MQTT_TLS_ENABLED=false
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_CA_FILE=
MQTT_TLS_CERT_FILE=
MQTT_TLS_KEY_FILE=

# Command state
COMMAND_ACK_TIMEOUT_MS=15000

# WebSocket URL (used by API to reach WS process)
WS_SERVER_URL=ws://127.0.0.1:8080

# Logging
LOG_LEVEL=info
LOG_FILE=var/log/server.log
