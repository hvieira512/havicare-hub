# Ingestão de dispositivos
TCP_INGRESS_HOST=0.0.0.0
TCP_INGRESS_PORT=9000
DOWNLINK_QUEUE_TTL_SECONDS=300
WHITELIST_FILE=
NCS_ENABLED=true
NCS_TOPIC_FILTER=/voerka/#
# A ingestão de gateways: o espaço de tópicos `.../gw/` é do hub, e entram por aqui os gateways
# MOKO e as pulseiras Veepoo que eles retransmitem. Os nomes antigos (MOKO_GATEWAY_*) ainda se leem.
GATEWAY_ENABLED=true
GATEWAY_TOPIC_FILTER=havicare-hub/null/0/gw/+/raw
GATEWAY_DEDUPE_TTL_SECONDS=5
GATEWAY_TELEMETRY_REFRESH_SECONDS=60
GATEWAY_IDLE_TIMEOUT_SECONDS=180
# O raw das observações retransmitidas vai para o histórico da dashboard no máximo uma vez por
# esta janela, por aparelho; no MQTT saem todas. Zero desliga a amostragem.
GATEWAY_RAW_HISTORY_SAMPLE_SECONDS=30

# Ingestão MQTT dos radares Qinglanst
QINGLANST_ENABLED=false
QINGLANST_MQTT_HOST=
QINGLANST_MQTT_PORT=1883
QINGLANST_MQTT_USERNAME=
QINGLANST_MQTT_PASSWORD=
QINGLANST_TOPIC_FILTER="radar/1001/#"
# Um por hub, como o MQTT_CLIENT_ID_PREFIX. Vazio vale `qinglanst-radar`, o da produção, e dois
# clientes com o mesmo id expulsam-se do broker em ciclo.
QINGLANST_CLIENT_ID_PREFIX=qinglanst-radar-local
# O radar publica no mesmo broker que o hub, e por isso herda o MQTT_TLS_ENABLED. Só se
# preenche no dia em que deixarem de ser o mesmo servidor.
QINGLANST_MQTT_TLS_ENABLED=
QINGLANST_DASHBOARD_SEEN_MIN_INTERVAL_MS=5000
# O raw do radar vai para o histórico da dashboard no máximo uma vez por esta janela, por
# radar; no MQTT saem todas. Zero desliga a amostragem.
QINGLANST_RAW_HISTORY_SAMPLE_MS=30000
# De quanto em quanto tempo o resumo de ingestão vai ao log, e só quando houve mensagens.
QINGLANST_STATS_FLUSH_SECONDS=300

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8081
# As credenciais vêm todas da tabela `api_users`. Com isto a `false`, a API não exige token e
# trata cada pedido como administrador anónimo: só para desenvolvimento local.
DASHBOARD_API_AUTH_REQUIRED=true
DASHBOARD_API_TOKEN_TTL_SECONDS=3600
DASHBOARD_API_REFRESH_TOKEN_TTL_SECONDS=2592000
# Origens que podem falar com a API a partir de um browser, separadas por vírgula. Vazio mantém
# a política aberta (`*`), segura enquanto a autenticação for Bearer em cabeçalho e não cookie.
CORS_ALLOWED_ORIGINS=
DASHBOARD_HISTORY_LIMIT=100
# Licença do amCharts, que desenha os sinais vitais de um radar. Vazia, os gráficos funcionam
# na mesma mas com o logótipo do fabricante por cima.
AMCHARTS_LICENSE=
DASHBOARD_COMMAND_TIMEOUT_SECONDS=3600
DASHBOARD_DEVICE_IDLE_TIMEOUT_SECONDS=1800

# Tetos de ligações abertas ao `/api/stream`, que nunca terminam. O limite é o event loop: sem
# `ev`/`event`/`uv` é `select(2)`, preso nos 1024 descritores, e 400 deixa ~600 para o resto.
# Para subir, instalar primeiro uma extensão de loop (ver `config/systemd/limit-nofile.conf`).
DASHBOARD_MAX_OPEN_STREAMS=400
DASHBOARD_MAX_OPEN_STREAMS_PER_USER=100

# Tetos de tentativas de autenticação, por janela: o `password_verify` a custo 12 bloqueia o loop
# ~175 ms por tentativa, e o teto global é o único que resiste a quem rode endereços.
DASHBOARD_LOGIN_MAX_PER_ADDRESS=20
DASHBOARD_LOGIN_MAX_PER_USERNAME=10
DASHBOARD_LOGIN_MAX_GLOBAL=10

# Redis (fila de downlink)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Antepõe-se a todas as chaves deste hub; vazio é a produção. Em `/opt/havicare-hub-dev` é `dev:`,
# e uma instância cujo directório acabe em `-dev` recusa arrancar com isto vazio.
REDIS_PREFIX=

# Base de dados
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=havicare_hub
DB_USER=hub
DB_PASSWORD=hub_pass
DB_CHARSET=utf8mb4

# Base de dados dos serviços do Docker Compose
HUB_DB_DRIVER=mysql
HUB_DB_HOST=mysql
HUB_DB_PORT=3306
HUB_DB_NAME=havicare_hub
HUB_DB_USER=hub
HUB_DB_PASSWORD=hub_pass
HUB_DB_ROOT_PASSWORD=root_pass
MYSQL_DB_NAME=havicare_hub
MYSQL_DB_USER=hub
MYSQL_DB_PASSWORD=hub_pass
TEST_DB_HOST=mysql
TEST_DB_PORT=3306
TEST_DB_ADMIN_USER=root
TEST_DB_ADMIN_PASSWORD=root_pass
TEST_DB_CHARSET=utf8mb4

# MQTT
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Em Docker, o hub usa o mosquitto local e ignora o MQTT_HOST acima. Para ver os aparelhos reais
# em localhost, HUB_MQTT_HOST com o endereço do broker remoto.
HUB_MQTT_HOST=
HUB_MQTT_PORT=
MQTT_USERNAME=
MQTT_PASSWORD=
# Um espaço de tópicos por hub: partilhá-lo faz dois hubs escreverem um por cima do outro.
MQTT_TOPIC_PREFIX=
# Um por hub: dois iguais expulsam-se do broker em ciclo. Máximo 14 caracteres. Vazio vale
# `health-mqtt`, o da produção, e por isso já vem preenchido.
MQTT_CLIENT_ID_PREFIX=health-local
MQTT_KEEPALIVE=60
MQTT_TIMEOUT=5
MQTT_TLS_ENABLED=false
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_CA_FILE=
MQTT_TLS_CERT_FILE=
MQTT_TLS_KEY_FILE=

# Resolução de localização sem GPS (mesmo envelope de telemetria, coordenadas juntas ao data)
LOCATION_RESOLUTION_ENABLED=true
BEACONDB_ENDPOINT=https://api.beacondb.net/v1/geolocate
BEACONDB_USER_AGENT="Havicare Hub/1.0"
BEACONDB_TIMEOUT_SECONDS=2
BEACONDB_MAX_ACCURACY_METERS=500
BEACONDB_CACHE_TTL_SECONDS=86400
BEACONDB_FAILURE_CACHE_TTL_SECONDS=60
LOCATION_PROVIDER_MAX_CONCURRENCY=5
LOCATION_PROVIDER_MAX_QUEUE=1000
LOCATION_CIRCUIT_FAILURE_THRESHOLD=3
LOCATION_CIRCUIT_OPEN_SECONDS=300
LOCATION_RATE_LIMIT_OPEN_SECONDS=3600
RADIO_MAP_ENABLED=true
# Um valor aleatório longo: os BSSID só se guardam como HMAC com esta chave.
RADIO_MAP_HASH_KEY=
RADIO_MAP_MINIMUM_MATCHES=2
RADIO_MAP_MAXIMUM_LEARNING_ACCURACY_METERS=100
RADIO_MAP_DEFAULT_GPS_ACCURACY_METERS=50
RADIO_MAP_MINIMUM_SATELLITES=4
RADIO_MAP_MAXIMUM_OBSERVATION_DISTANCE_METERS=250
RADIO_MAP_CLUSTER_RADIUS_METERS=150
RADIO_MAP_CACHE_TTL_SECONDS=60

# Mosquitto local: arranque e testes de fumo
MQTT_PUBLISHER_USERNAME=hub_publisher
MQTT_PUBLISHER_PASSWORD=hub_publisher_pass
MQTT_SMOKE_USERNAME=hub_smoke
MQTT_SMOKE_PASSWORD=hub_smoke_pass

# Logging
LOG_LEVEL=info
LOG_FILE=var/log/server.log
# O canal `api` escreve à parte: o registo de pedidos apagaria a retenção operacional.
LOG_FILE_API=var/log/api.log
# Tecto por registo do corpo de cada pedido e resposta.
LOG_BODY_MAX_BYTES=16384
# Acima disto o corpo nem é descodificado; só se regista o tamanho.
LOG_BODY_SCAN_MAX_BYTES=1048576
