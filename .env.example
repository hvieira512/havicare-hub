# Device ingress
TCP_INGRESS_HOST=0.0.0.0
TCP_INGRESS_PORT=9000
DOWNLINK_QUEUE_TTL_SECONDS=300
WHITELIST_FILE=
NCS_ENABLED=true
NCS_TOPIC_FILTER=/voerka/#
MOKO_GATEWAY_ENABLED=true
MOKO_GATEWAY_TOPIC_FILTER=havicare-hub/null/0/gw/+/raw
MOKO_GATEWAY_DEDUPE_TTL_SECONDS=5
MOKO_GATEWAY_TELEMETRY_REFRESH_SECONDS=60
MOKO_GATEWAY_IDLE_TIMEOUT_SECONDS=180

# Qinglanst radar MQTT ingress
QINGLANST_ENABLED=false
QINGLANST_MQTT_HOST=
QINGLANST_MQTT_PORT=1883
QINGLANST_MQTT_USERNAME=
QINGLANST_MQTT_PASSWORD=
QINGLANST_TOPIC_FILTER="radar/1001/#"
QINGLANST_CLIENT_ID_PREFIX=qinglanst-radar
QINGLANST_DASHBOARD_SEEN_MIN_INTERVAL_MS=5000
QINGLANST_POSITION_HISTORY_SAMPLE_MS=1000
# De quanto em quanto tempo o resumo de ingestao vai ao log, e so quando houve mensagens.
QINGLANST_STATS_FLUSH_SECONDS=300

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8081
# Nao ha administrador de arranque por ambiente: as credenciais vem todas da tabela
# `api_users`. Com isto a `false`, a API deixa de exigir token e trata cada pedido como
# administrador anonimo -- so para desenvolvimento local.
DASHBOARD_API_AUTH_REQUIRED=true
DASHBOARD_API_TOKEN_TTL_SECONDS=3600
DASHBOARD_API_REFRESH_TOKEN_TTL_SECONDS=2592000
DASHBOARD_HISTORY_LIMIT=100
DASHBOARD_COMMAND_TIMEOUT_SECONDS=3600
DASHBOARD_DEVICE_IDLE_TIMEOUT_SECONDS=1800

# Redis downlink queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Antepõe-se a todas as chaves deste hub. Vazio é o valor de produção: as chaves ficam onde
# sempre estiveram, sob `hub:`. Preenche-se para correr uma segunda instância contra o mesmo
# Redis -- um hub de desenvolvimento, por exemplo -- sem lhe pisar as chaves.
REDIS_PREFIX=

# Database
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hitecosystem_hub
DB_USER=hub
DB_PASSWORD=hub_pass
DB_CHARSET=utf8mb4

# Docker Compose service database overrides
HUB_DB_DRIVER=mysql
HUB_DB_HOST=mysql
HUB_DB_PORT=3306
HUB_DB_NAME=hitecosystem_hub
HUB_DB_USER=hub
HUB_DB_PASSWORD=hub_pass
HUB_DB_ROOT_PASSWORD=root_pass
MYSQL_DB_NAME=hitecosystem_hub
MYSQL_DB_USER=hub
MYSQL_DB_PASSWORD=hub_pass
TEST_DB_HOST=mysql
TEST_DB_PORT=3306
TEST_DB_ADMIN_USER=root
TEST_DB_ADMIN_PASSWORD=root_pass
TEST_DB_CHARSET=utf8mb4

# MQTT
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Em Docker, o hub usa o mosquitto local e ignora o MQTT_HOST acima. Para o apontar a um
# broker remoto -- e ver os gateways, medidores de fraldas, pulseiras e radares reais em
# localhost -- define HUB_MQTT_HOST com o endereco desse broker.
HUB_MQTT_HOST=
HUB_MQTT_PORT=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=
MQTT_CLIENT_ID_PREFIX=havicare-hub
MQTT_KEEPALIVE=60
MQTT_TIMEOUT=5
MQTT_TLS_ENABLED=false
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_CA_FILE=
MQTT_TLS_CERT_FILE=
MQTT_TLS_KEY_FILE=

# Non-GPS location resolution (same telemetry envelope, coordinates merged into data)
LOCATION_RESOLUTION_ENABLED=true
BEACONDB_ENDPOINT=https://api.beacondb.net/v1/geolocate
BEACONDB_USER_AGENT="HaviCare Devices Hub/1.0"
BEACONDB_TIMEOUT_SECONDS=2
BEACONDB_MAX_ACCURACY_METERS=500
BEACONDB_CACHE_TTL_SECONDS=86400
BEACONDB_FAILURE_CACHE_TTL_SECONDS=60
LOCATION_PROVIDER_MAX_CONCURRENCY=5
LOCATION_PROVIDER_MAX_QUEUE=1000
LOCATION_CIRCUIT_FAILURE_THRESHOLD=3
LOCATION_CIRCUIT_OPEN_SECONDS=300
LOCATION_RATE_LIMIT_OPEN_SECONDS=3600
RADIO_MAP_ENABLED=true
# Use a long random value. BSSIDs are stored only as keyed HMAC hashes.
RADIO_MAP_HASH_KEY=
RADIO_MAP_MINIMUM_MATCHES=2
RADIO_MAP_MAXIMUM_LEARNING_ACCURACY_METERS=100
RADIO_MAP_DEFAULT_GPS_ACCURACY_METERS=50
RADIO_MAP_MINIMUM_SATELLITES=4
RADIO_MAP_MAXIMUM_OBSERVATION_DISTANCE_METERS=250
RADIO_MAP_CLUSTER_RADIUS_METERS=150
RADIO_MAP_CACHE_TTL_SECONDS=60

# Local Mosquitto bootstrap / smoke tests
MQTT_PUBLISHER_USERNAME=hub_publisher
MQTT_PUBLISHER_PASSWORD=hub_publisher_pass
MQTT_SMOKE_USERNAME=hub_smoke
MQTT_SMOKE_PASSWORD=hub_smoke_pass

# Logging
LOG_LEVEL=info
LOG_FILE=var/log/server.log
# O canal `api` escreve a parte; sem isto o registo de pedidos apaga a retencao operacional.
LOG_FILE_API=var/log/api.log
# Tecto por registo do corpo de cada pedido e resposta.
LOG_BODY_MAX_BYTES=16384
# Acima disto o corpo nem e descodificado, so se regista o tamanho.
LOG_BODY_SCAN_MAX_BYTES=1048576
