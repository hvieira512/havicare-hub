<?xml version="1.0"?>
<!--
    Sem este ficheiro o phpcs não encontra ruleset nenhum e cai no seu próprio
    default, que no phpcs 4 é o PSR12. Isso dava 1068 avisos, 875 dos quais uma
    só regra: LineLength.

    O limite de 120 não é excluído por preguiça — é que o projeto nunca o
    observou. Das 880 linhas longas a mediana tem 141 caracteres e o p90 tem
    222, portanto nem um limite de 200 as calaria. E o PSR12 mede todas as
    linhas do ficheiro, incluindo o HTML dos templates do Dashboard, onde uma
    linha é um <button> com classes Bootstrap e não código PHP.

    Repor a regra no dia em que as linhas forem encurtadas, não antes.
-->
<ruleset name="hub">
    <description>PSR-12 sem o limite de comprimento de linha.</description>

    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <!--
        Os 8 scripts do `simulator/` são pontos de entrada CLI: correm no topo do ficheiro e
        alguns declaram uma classe de apoio a meio. Isso viola três regras de estrutura por
        aquilo que são, não por estarem mal escritos, e eram elas que punham o `composer
        style` a devolver 4 erros: o portão estava vermelho e ninguém reparava, porque
        ninguém lia o código de saída.

        É a mesma fronteira que o `phpstan.neon` já traça, e pela mesma razão. O que fica
        de fora é só a estrutura: a indentação, as chavetas e os espaços continuam a ser
        verificados nestes ficheiros como em todos os outros.
    -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>simulator/*</exclude-pattern>
        <!--
            Os componentes do template são a mesma figura pelo outro lado: puxam os
            auxiliares de que dependem e declaram a função que os desenha, no mesmo
            ficheiro, porque é assim que um parcial se usa.
        -->
        <exclude-pattern>src/Dashboard/components/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration">
        <exclude-pattern>simulator/*</exclude-pattern>
    </rule>
    <rule ref="PSR12.Files.FileHeader">
        <exclude-pattern>simulator/*</exclude-pattern>
    </rule>

    <!--
        Um teste que declara o seu duplo ao lado do caso que o usa tem os dois à vista, e é
        assim que 15 ficheiros de teste estão escritos. Exigir um ficheiro por classe aqui
        espalhava cada duplo por um ficheiro só dele, longe do único teste que o usa, e era
        o resto dos 15 erros que mantinham o `composer style` vermelho.
    -->
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
