<?xml version="1.0"?>
<!--
    Sem o limite de linha: o projeto nunca o observou, e o PSR12 mede também o HTML dos
    templates. Repor a regra quando as linhas forem encurtadas.
-->
<ruleset name="hub">
    <description>PSR-12 sem o limite de comprimento de linha.</description>

    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <!--
        Os scripts do `simulator/` são pontos de entrada CLI que correm no topo e às vezes
        declaram uma classe: fica de fora só a estrutura, como no `phpstan.neon`.
    -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>simulator/*</exclude-pattern>
        <!-- Os componentes do template puxam os auxiliares e declaram a função que os desenha. -->
        <exclude-pattern>src/Dashboard/components/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration">
        <exclude-pattern>simulator/*</exclude-pattern>
    </rule>
    <rule ref="PSR12.Files.FileHeader">
        <exclude-pattern>simulator/*</exclude-pattern>
    </rule>

    <!-- Os testes declaram os seus duplos ao lado do caso que os usa. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!--
        O `strict_types` é obrigatório: num hub cheio de descodificadores binários, uma
        coerção silenciosa de "12abc" para 12 é um valor errado guardado sem erro.
    -->
    <rule ref="Generic.PHP.RequireStrictTypes">
        <!-- Os parciais do template não declaram nada: abrem com HTML. -->
        <!-- O caso-base HTTP exercita a coerção do número da licença, que vem em texto. -->
        <exclude-pattern>tests/Support/DashboardHttpTestCase.php</exclude-pattern>
        <exclude-pattern>src/Dashboard/components/*</exclude-pattern>
        <exclude-pattern>src/Dashboard/index.php</exclude-pattern>
    </rule>
</ruleset>
