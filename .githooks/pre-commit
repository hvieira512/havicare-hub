#!/bin/sh
#
# As verificações do `composer test` que não precisam de base de dados, de Redis
# nem de contentores: phpcs, phpstan e eslint, em poucos segundos. As outras
# cinco ficam de fora porque levantam contentores e um `git commit` que demora
# minutos deixa de ser usado. Isto não substitui o `composer test` antes de
# empurrar; para saltar num commit intermédio, `git commit --no-verify`.

set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

if [ -x vendor/bin/phpcs ]; then
    if ! vendor/bin/phpcs src tests simulator bin; then
        echo ""
        echo "pre-commit: o estilo do PHP não passa. 'composer style:fix' corrige a maioria."
        exit 1
    fi
fi

if [ -x vendor/bin/phpstan ]; then
    if ! php -d memory_limit=1G vendor/bin/phpstan analyse --no-progress; then
        echo ""
        echo "pre-commit: a análise estática não passa."
        exit 1
    fi
fi

if [ -x node_modules/.bin/eslint ]; then
    if ! npm run lint --silent; then
        echo ""
        echo "pre-commit: o eslint não passa."
        exit 1
    fi
fi
