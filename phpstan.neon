# Sem baseline: o nível 6 passa limpo em `src`, `bin` e `tests`, e um array sem forma
# declarada é erro.
includes:
    # Ensina o analisador a ler os duplos do PHPUnit: sem isto, cada `->method()` num
    # stub é um `method.notFound` que não é defeito nenhum.
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    # O nível 6 exige a forma dos arrays, que é onde os tipos deste projecto eram
    # uma promessa vaga: um `array` sem forma não diz nada a quem o recebe.
    level: 6
    paths:
        - src
        - bin
        - tests
        # `simulator/` fica de fora: os 8 scripts são pontos de entrada CLI independentes
        # que partilham 20 nomes de função globais (`describe`, `waitForMessages`, ...) com
        # assinaturas diferentes. Analisados no mesmo processo colidem, e o PHPStan verifica
        # cada chamada contra a definição do ficheiro errado.
    tmpDir: var/phpstan

    ignoreErrors:
        # Uma asserção sobre um valor que o analisador já conhece é o que um teste faz: a
        # fixture é literal de propósito, e prendê-la é o ponto. Só em `tests/`.
        -
            identifier: staticMethod.alreadyNarrowedType
            path: tests/*
        -
            identifier: staticMethod.impossibleType
            path: tests/*
        -
            identifier: function.alreadyNarrowedType
            path: tests/*

        # notIdentical.alwaysTrue is deliberately NOT here: it is what would
        # have caught an int licenseId compared against the string '0', and
        # silencing it cost a live bug.
        # Defensive style rather than defects: `?? ` on an offset that happens to
        # always exist, a redundant is_array() on a known array, `?->` on a value
        # this call site cannot receive as null. Removing them would make the code
        # more brittle against inputs the type system only *believes* are narrow.
        - identifier: nullCoalesce.offset
        - identifier: nullsafe.neverNull
        - identifier: function.alreadyNarrowedType
        - identifier: booleanAnd.rightAlwaysTrue
        - identifier: instanceof.alwaysTrue
        # A nullable return kept because the interface it implements allows null.
        - identifier: return.unusedType
        # A generic mixed-value callback and a regex capture: PHPStan narrows
        # these from the literal at the call site, but the guards are the
        # function's own contract with any future caller.
        -
            identifier: notIdentical.alwaysTrue
            paths:
                - src/Api/Routing/ApiRoute.php
                - src/Device/DeviceEventDecoder.php
                - src/Device/Decoder/VivistarEventDecoder.php
                - src/Protocol/Adapter/VivistarAdapter.php
        # Predis declares pipeline() on Client, not on ClientInterface. Narrowing
        # our hints to Client would break the in-memory doubles the tests use,
        # which implement the interface.
        -
            message: '#Call to an undefined method Predis\\ClientInterface::pipeline\(\)#'

        # The subscriber is assigned after the closure that reads it is built, so
        # the by-reference capture is populated by the time it runs. The `?->`
        # is the guard for the window before that.
        -
            message: '#Cannot call method handleReceivedMessage\(\) on null#'
            path: src/Ingress/Mqtt/SubscriberFactory.php
