# Limita o log do hub por tamanho, não por calendário: é o volume que cresce sem parar.
# `copytruncate` é obrigatório: o processo mantém os descritores abertos e o Monolog não os reabre.
# O padrão apanha as duas instâncias: /opt/havicare-hub e /opt/havicare-hub-dev.
/opt/havicare-hub*/var/log/api.log {
    size 64M
    rotate 40
    compress
    copytruncate
    nocreate
    nodateext
    missingok
    notifempty
}

/opt/havicare-hub*/var/log/server.log {
    size 16M
    rotate 10
    compress
    copytruncate
    nocreate
    nodateext
    missingok
    notifempty
}
