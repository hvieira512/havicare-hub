# Limita o log do hub por tamanho, nao por calendario: o volume e que cresce sem parar.
# copytruncate e obrigatorio -- o processo mantem os descritores abertos e o Monolog nao os reabre.
# O padrao apanha as duas instancias: /opt/havicare-hub e /opt/havicare-hub-dev.
/opt/havicare-hub*/var/log/api.log {
    size 64M
    rotate 40
    compress
    copytruncate
    nocreate
    nodateext
    missingok
    notifempty
}

/opt/havicare-hub*/var/log/server.log {
    size 16M
    rotate 10
    compress
    copytruncate
    nocreate
    nodateext
    missingok
    notifempty
}
