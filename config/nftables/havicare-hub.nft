#!/usr/sbin/nft -f
# Fecha o 3306 à internet: o MariaDB escuta em 0.0.0.0, e só passam o localhost e o IP de quem
# administra. A política é `accept` de propósito: esta tabela filtra o 3306 e mais nada.

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter; policy accept;

        iif lo accept

        # O IP de quem administra, residencial e mutável: é a linha a rever. Em alternativa, um túnel:
        # ssh -L 3306:127.0.0.1:3306 hub-prod
        tcp dport 3306 ip saddr 2.83.14.236 accept

        tcp dport 3306 drop
    }
}
